<svg width="1600" height="900" viewBox="0 0 1600 900" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1600" y2="900" gradientUnits="userSpaceOnUse">
      <stop stop-color="#07111F"/>
      <stop offset="1" stop-color="#0F172A"/>
    </linearGradient>
    <linearGradient id="card" x1="0" y1="0" x2="0" y2="1" gradientUnits="userSpaceOnUse">
      <stop stop-color="#162033"/>
      <stop offset="1" stop-color="#101827"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="1" gradientUnits="userSpaceOnUse">
      <stop stop-color="#38BDF8"/>
      <stop offset="1" stop-color="#F97316"/>
    </linearGradient>
    <linearGradient id="line" x1="0" y1="0" x2="1" y2="0" gradientUnits="userSpaceOnUse">
      <stop stop-color="#38BDF8"/>
      <stop offset="1" stop-color="#F97316"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="18" flood-color="#000000" flood-opacity="0.35"/>
    </filter>
    <style>
      .title{font:700 54px Inter,Arial,sans-serif; fill:#F8FAFC;}
      .subtitle{font:400 22px Inter,Arial,sans-serif; fill:#CBD5E1;}
      .label{font:600 18px Inter,Arial,sans-serif; fill:#94A3B8;}
      .kpi{font:800 34px Inter,Arial,sans-serif; fill:#F8FAFC;}
      .small{font:500 16px Inter,Arial,sans-serif; fill:#CBD5E1;}
      .cardText{font:700 20px Inter,Arial,sans-serif; fill:#E2E8F0;}
      .axis{stroke:#334155; stroke-width:2;}
      .grid{stroke:#1F2937; stroke-width:1;}
    </style>
  </defs>

  <rect width="1600" height="900" fill="url(#bg)"/>

  <circle cx="1320" cy="150" r="180" fill="#0EA5E9" opacity="0.08"/>
  <circle cx="240" cy="760" r="240" fill="#F97316" opacity="0.06"/>

  <rect x="70" y="60" width="1460" height="780" rx="36" fill="url(#card)" filter="url(#shadow)"/>

  <text x="120" y="150" class="title">Sales Performance Dashboard</text>
  <text x="120" y="195" class="subtitle">Live Power BI reporting for underperforming region detection</text>

  <!-- KPI cards -->
  <rect x="120" y="245" width="320" height="150" rx="24" fill="#0F172A" opacity="0.95"/>
  <text x="150" y="292" class="label">Total Revenue</text>
  <text x="150" y="340" class="kpi">$1.28M</text>
  <rect x="150" y="362" width="120" height="12" rx="6" fill="#1E293B"/>
